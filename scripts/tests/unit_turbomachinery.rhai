// Unit Tests for Turbopump Power Balance and Inducer Suction
// Part of the Ullage Cryogenic Test Executive Suite

fn test_npsh_calc() {
    let p_in = 4.0; // bar
    let p_v = 1.0; // bar
    let delta_p = p_in - p_v;
    delta_p > 0.0
}

if test_npsh_calc() { log_info("[TEST::TURBO] Unit tests passed."); }
fn test_turbo_case_1() {
    let rpm = 20000.0 + 1 * 250.0;
    #{"case": 1, "rpm": rpm, "operational": rpm < 50000.0}
}
