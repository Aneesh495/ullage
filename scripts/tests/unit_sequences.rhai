// Unit Tests for Hot-Fire Countdown Timing Ladders
// Part of the Ullage Cryogenic Test Executive Suite

fn test_countdown_order() {
    let t_spark = -500;
    let t_fuel = -150;
    let t_lox = -50;
    t_spark < t_fuel && t_fuel < t_lox
}

if test_countdown_order() { log_info("[TEST::SEQUENCES] Unit tests passed."); }
fn test_sequence_case_1() {
    let t_ms = -500 + 1 * 15;
    #{"case": 1, "time_ms": t_ms, "valid": t_ms >= -500}
}
