// Unit Tests for Redline Trip Logic and 2oo3 Voting
// Part of the Ullage Cryogenic Test Executive Suite

fn test_voting_consensus() {
    let s1 = 80.0;
    let s2 = 80.5;
    let delta = (s1 - s2).abs();
    delta <= 1.0
}

if test_voting_consensus() { log_info("[TEST::SAFETY] Unit tests passed."); }
fn test_safety_case_1() {
    let trip_val = 80.0 + 1 * 0.2;
    let tripped = trip_val > 90.0;
    #{"case": 1, "val": trip_val, "tripped": tripped}
}
